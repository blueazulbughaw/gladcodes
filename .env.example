# Copy this file to .env and fill in real values. Never commit .env.

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET=change-me-to-a-different-long-random-string

# Public site
PUBLIC_SITE_URL=https://glad.codes/

# Database (cPanel: gladcodes / phpMyAdmin)
DB_HOST=localhost
DB_NAME=gladcodes_maindb
DB_USER=gladcodes_admn
DB_PASSWORD=

# GitHub API (optional). Without a token the site still works, just with
# lower (unauthenticated) GitHub API rate limits.
GITHUB_TOKEN=

# IANA timezone for the daily check-in's "today" (e.g. America/New_York, Asia/Manila)
LOCAL_TIMEZONE=

# Web Push reminders for the daily check-in. Generate with: python generate_vapid_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: contact URL the push services can reach you at
VAPID_SUBJECT=
# Local hours (24h) for the morning / evening check-in reminders
CHECKIN_MORNING_HOUR=8
CHECKIN_EVENING_HOUR=21

# Contact form delivery. Defaults work as-is on cPanel shared hosting
# (local Exim relay on localhost:25). Only set SMTP_USER/SMTP_PASSWORD if
# the host requires authenticated submission instead.
MAIL_TO=hello@gladcodes.com
MAIL_FROM=noreply@glad.codes
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
